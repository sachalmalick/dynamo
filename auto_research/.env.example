# Copy to .env (or export in your shell) to run the LangChain backend.

# Backend: "llm" or "heuristic". If unset, auto-detects: llm when an API key is
# present, heuristic otherwise.
AUTO_RESEARCH_MODE=llm

# Provider + model for the LLM backend.
AUTO_RESEARCH_PROVIDER=anthropic
AUTO_RESEARCH_MODEL=claude-sonnet-5

# API key for the chosen provider.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Optional: where the editable Planner policy lives (defaults to a temp dir).
# AUTO_RESEARCH_WORKSPACE=./.workspace
